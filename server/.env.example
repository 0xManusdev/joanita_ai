# Copie ce fichier en .env et remplis ta clé (ne commite JAMAIS le fichier .env)
RODIUMAI_API_KEY=rd_sk_xxx
# Modèle utilisé par défaut
MODEL=google/gemini-3.1-flash-lite
# Modèles proposés dans l'interface (liste blanche). Seuls ceux que ta clé peut utiliser s'affichent : voir npm run models
MODELS=google/gemini-3.1-flash-lite,google/gemma-4-31b,google/gemini-3-flash-preview,google/gemini-3.8-flash,google/gemini-2.5-pro
ALLOWED_ORIGIN=http://localhost:5173
# Recherche web de l'agent (optionnel) : clé gratuite sur tavily.com. Sans clé, l'agent cherche sur Wikipédia.
TAVILY_API_KEY=
